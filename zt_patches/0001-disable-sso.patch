Date: Wed, 7 Oct 2026 06:32:14 +0800
Subject: [PATCH 1/3] disable-sso

---
 CMakeLists.txt | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3d920a1..a47eded 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -215,6 +215,9 @@ if(MSVC)
 endif()
 
 # Single sign-on (OIDC) support.
+# MYSELF: force SSO off. The per-architecture branches above set this TRUE on
+# x86_64/i386/armhf/aarch64, so the override must come after all of them.
+set(ZT_SSO_SUPPORTED FALSE)
 if(ZT_SSO_SUPPORTED)
     add_definitions(-DZT_SSO_SUPPORTED=1)
 endif()
